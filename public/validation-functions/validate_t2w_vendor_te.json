{
  "id": "validate_t2w_vendor_te",
  "name": "T2w vendor echo time",
  "description": "Vendor-specific TE check for T2w, per the spine-generic protocol specs. (From the Generic Spine Protocol schema.)",
  "category": "Echo Timing",
  "fields": [
    "Manufacturer",
    "EchoTime"
  ],
  "requiredSystemFields": [],
  "parameters": null,
  "implementation": "m = str(ctx.rows[0].get(\"Manufacturer\", \"\")).upper()\nte = ctx.rows[0].get(\"EchoTime\")\nif te is not None:\n    te = float(te)\n    if \"SIEMENS\" in m:\n        if not (110 <= te <= 130):\n            ctx.error(f\"Siemens SPACE TE should be 110-130 ms. Found: {te} ms\")\n    elif \"GE\" in m:\n        if not (110 <= te <= 130):\n            ctx.error(f\"GE CUBE TE should be 110-130 ms. Found: {te} ms\")\n    elif \"PHILIPS\" in m:\n        if not (110 <= te <= 130):\n            ctx.error(f\"Philips VISTA TE should be 110-130 ms. Found: {te} ms\")",
  "testCases": [
    {
      "id": "test_validate_t2w_vendor_te_siemens_pass",
      "name": "SIEMENS in range",
      "data": {
        "Manufacturer": [
          "SIEMENS"
        ],
        "EchoTime": [
          120.0
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_t2w_vendor_te_siemens_fail",
      "name": "SIEMENS out of range",
      "data": {
        "Manufacturer": [
          "SIEMENS"
        ],
        "EchoTime": [
          395
        ]
      },
      "expectedResult": "fail",
      "description": ""
    },
    {
      "id": "test_validate_t2w_vendor_te_ge_pass",
      "name": "GE in range",
      "data": {
        "Manufacturer": [
          "GE"
        ],
        "EchoTime": [
          120.0
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_t2w_vendor_te_ge_fail",
      "name": "GE out of range",
      "data": {
        "Manufacturer": [
          "GE"
        ],
        "EchoTime": [
          395
        ]
      },
      "expectedResult": "fail",
      "description": ""
    },
    {
      "id": "test_validate_t2w_vendor_te_philips_pass",
      "name": "PHILIPS in range",
      "data": {
        "Manufacturer": [
          "PHILIPS"
        ],
        "EchoTime": [
          120.0
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_t2w_vendor_te_philips_fail",
      "name": "PHILIPS out of range",
      "data": {
        "Manufacturer": [
          "PHILIPS"
        ],
        "EchoTime": [
          395
        ]
      },
      "expectedResult": "fail",
      "description": ""
    }
  ]
}
