{
  "id": "validate_t1w_vendor_te",
  "name": "T1w vendor echo time",
  "description": "Vendor-specific TE check for T1w, per the spine-generic protocol specs. (From the Generic Spine Protocol schema.)",
  "category": "Echo Timing",
  "fields": [
    "Manufacturer",
    "EchoTime"
  ],
  "requiredSystemFields": [],
  "parameters": null,
  "implementation": "m = str(ctx.rows[0].get(\"Manufacturer\", \"\")).upper()\nte = ctx.rows[0].get(\"EchoTime\")\nif te is not None:\n    te = float(te)\n    if \"SIEMENS\" in m:\n        if not (2.5 <= te <= 4.5):\n            ctx.error(f\"Siemens MPRAGE TE should be 2.5-4.5 ms. Found: {te} ms\")\n    elif \"PHILIPS\" in m:\n        if not (2.5 <= te <= 4.5):\n            ctx.error(f\"Philips T1TFE TE should be 2.5-4.5 ms. Found: {te} ms\")",
  "testCases": [
    {
      "id": "test_validate_t1w_vendor_te_siemens_pass",
      "name": "SIEMENS in range",
      "data": {
        "Manufacturer": [
          "SIEMENS"
        ],
        "EchoTime": [
          3.5
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_t1w_vendor_te_siemens_fail",
      "name": "SIEMENS out of range",
      "data": {
        "Manufacturer": [
          "SIEMENS"
        ],
        "EchoTime": [
          18.5
        ]
      },
      "expectedResult": "fail",
      "description": ""
    },
    {
      "id": "test_validate_t1w_vendor_te_philips_pass",
      "name": "PHILIPS in range",
      "data": {
        "Manufacturer": [
          "PHILIPS"
        ],
        "EchoTime": [
          3.5
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_t1w_vendor_te_philips_fail",
      "name": "PHILIPS out of range",
      "data": {
        "Manufacturer": [
          "PHILIPS"
        ],
        "EchoTime": [
          18.5
        ]
      },
      "expectedResult": "fail",
      "description": ""
    }
  ]
}
