{
  "id": "validate_mts_t1w_vendor_te",
  "name": "MTS T1w vendor echo time",
  "description": "Vendor-specific TE check for MTS T1w, per the spine-generic protocol specs. (From the Generic Spine Protocol schema.)",
  "category": "Contrast Preparation",
  "fields": [
    "Manufacturer",
    "EchoTime"
  ],
  "requiredSystemFields": [],
  "parameters": null,
  "implementation": "m = str(ctx.rows[0].get(\"Manufacturer\", \"\")).upper()\nte = ctx.rows[0].get(\"EchoTime\")\nif te is not None:\n    te = float(te)\n    if \"SIEMENS\" in m:\n        if not (2.5 <= te <= 4.5):\n            ctx.error(f\"Siemens MTS T1w TE should be 2.5-4.5 ms. Found: {te} ms\")\n    elif \"GE\" in m:\n        if not (3.0 <= te <= 5.0):\n            ctx.error(f\"GE MTS T1w TE should be 3.0-5.0 ms. Found: {te} ms\")\n    elif \"PHILIPS\" in m:\n        if not (1.5 <= te <= 3.0):\n            ctx.error(f\"Philips MTS T1w TE should be 1.5-3.0 ms. Found: {te} ms\")",
  "testCases": [
    {
      "id": "test_validate_mts_t1w_vendor_te_siemens_pass",
      "name": "SIEMENS in range",
      "data": {
        "Manufacturer": [
          "SIEMENS"
        ],
        "EchoTime": [
          3.5
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_mts_t1w_vendor_te_siemens_fail",
      "name": "SIEMENS out of range",
      "data": {
        "Manufacturer": [
          "SIEMENS"
        ],
        "EchoTime": [
          18.5
        ]
      },
      "expectedResult": "fail",
      "description": ""
    },
    {
      "id": "test_validate_mts_t1w_vendor_te_ge_pass",
      "name": "GE in range",
      "data": {
        "Manufacturer": [
          "GE"
        ],
        "EchoTime": [
          4.0
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_mts_t1w_vendor_te_ge_fail",
      "name": "GE out of range",
      "data": {
        "Manufacturer": [
          "GE"
        ],
        "EchoTime": [
          20.0
        ]
      },
      "expectedResult": "fail",
      "description": ""
    },
    {
      "id": "test_validate_mts_t1w_vendor_te_philips_pass",
      "name": "PHILIPS in range",
      "data": {
        "Manufacturer": [
          "PHILIPS"
        ],
        "EchoTime": [
          2.25
        ]
      },
      "expectedResult": "pass",
      "description": ""
    },
    {
      "id": "test_validate_mts_t1w_vendor_te_philips_fail",
      "name": "PHILIPS out of range",
      "data": {
        "Manufacturer": [
          "PHILIPS"
        ],
        "EchoTime": [
          14.0
        ]
      },
      "expectedResult": "fail",
      "description": ""
    }
  ]
}
