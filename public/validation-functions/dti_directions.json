  "id": "dti_directions",
  "name": "Direction Count (>=30)",
  "description": ">=30 unique diffusion directions (60 ideal) for a stable tensor and reliable V1. (From the HC-ChiSep Validation Protocol schema.)",
  "category": "Diffusion",
  "fields": [
    "DiffusionBValue",
    "DiffusionGradientOrientation"
  ],
  "requiredSystemFields": [],
  "parameters": null,
  "implementation": "if \"DiffusionGradientOrientation\" not in value.columns:\n    raise ValidationWarning(\"Cannot count directions (DiffusionGradientOrientation absent); ensure >=30 (ideally 60).\")\nb = value[\"DiffusionBValue\"].fillna(0).astype(float)\ndirs = set()\nfor ok, o in zip(b > 50, value[\"DiffusionGradientOrientation\"]):\n    if ok and o is not None and o == o:\n        try:\n            dirs.add(tuple(round(float(x), 3) for x in o))\n        except TypeError:\n            pass\nn = len(dirs)\nif n < 12:\n    raise ValidationError(f\"Only {n} diffusion directions; >=30 needed for a robust tensor (60 ideal).\")\nif n < 30:\n    raise ValidationWarning(f\"{n} directions; >=30 recommended (60 ideal) for reliable V1 -> fibre angle.\")",
